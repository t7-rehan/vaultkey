# ============================================================
# VaultKey Backend — Test Environment Variables
# Copy this file to .env.test and fill in test values.
# ============================================================

# ── JWT ────────────────────────────────────────────────────
# Test JWT secret (not for production!)
JWT_SECRET=test_jwt_secret_key_for_testing_only_not_production

# ── Database ───────────────────────────────────────────────
# Use SQLite in-memory for fast tests, or a separate test database
DATABASE_URL=sqlite:///:memory:
# Or use a test PostgreSQL database:
# DATABASE_URL=postgresql://user:password@localhost/vaultkey_test

# ── Cloudflare R2 (Mock) ───────────────────────────────────
# For unit tests that don't actually call R2, these can be dummy values
R2_ACCOUNT_ID=test_account_id
R2_BUCKET_NAME=vaultkey-test
R2_ACCESS_KEY_ID=test_access_key
R2_SECRET_ACCESS_KEY=test_secret_key

# ── Server ─────────────────────────────────────────────────
PORT=8001

# ── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
