# ============================================================
# VaultKey Frontend — environment variables (Vite)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Variable names MUST start with VITE_ to be exposed to the browser.
# ============================================================

# Base URL for the VaultKey API.
# Local dev (proxied by Vite):  leave empty or use /api
# Pointing directly at the backend: http://localhost:8000/api
VITE_API_BASE_URL=/api

# Firebase client SDK configuration (from Firebase Console → Project Settings → General)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
