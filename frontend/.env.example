# ============================================================
# VaultKey Frontend — environment variables (Vite)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Variable names MUST start with VITE_ to be exposed to the browser.
# ============================================================

# Base URL for the VaultKey API.
# 
# Local development (proxied by Vite): leave empty or use /api
# Pointing directly at local backend: http://localhost:8000
# Production deployment (Vercel/Netlify): https://your-backend.railway.app
# 
# Examples:
#   VITE_API_BASE_URL=/api                                    (dev with proxy)
#   VITE_API_BASE_URL=http://localhost:8000                   (dev direct)
#   VITE_API_BASE_URL=https://vaultkey-api.railway.app        (production)
VITE_API_BASE_URL=/api
