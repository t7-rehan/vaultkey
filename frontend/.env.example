# ============================================================
# VaultKey Frontend — environment variables (Vite)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Variable names MUST start with VITE_ to be exposed to the browser.
# ============================================================

# Base URL for the VaultKey API.
# Local dev (proxied by Vite):  leave empty or use /api
# Pointing directly at the backend: http://localhost:8000/api
VITE_API_BASE_URL=/api
